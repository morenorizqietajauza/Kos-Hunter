// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role
  createdAt DateTime @default(now())

  kos       Kos[]
  bookings  Booking[]
  reviews   Review[]
}

model Kos {
  id              Int      @id @default(autoincrement())
  ownerId         Int
  name            String
  address         String
  pricePerMonth   Int
  gender          Gender
  description     String?

  owner           User     @relation(fields: [ownerId], references: [id])
  images          KosImage[]
  facilities      KosFacility[]
  bookings        Booking[]
  reviews         Review[]

  createdAt       DateTime @default(now())
}

model KosImage {
  id     Int  @id @default(autoincrement())
  kosId  Int
  image  String

  kos    Kos  @relation(fields: [kosId], references: [id])
}

model Facility {
  id     Int    @id @default(autoincrement())
  name   String

  kos    KosFacility[]
}

model KosFacility {
  id         Int      @id @default(autoincrement())
  kosId      Int
  facilityId Int

  kos        Kos      @relation(fields: [kosId], references: [id])
  facility   Facility @relation(fields: [facilityId], references: [id])
}

model Booking {
  id        Int      @id @default(autoincrement())
  kosId     Int
  userId    Int
  startDate DateTime
  endDate   DateTime
  status    BookingStatus @default(PENDING)

  kos       Kos  @relation(fields: [kosId], references: [id])
  user      User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Review {
  id       Int    @id @default(autoincrement())
  kosId    Int
  userId   Int
  comment  String
  reply    String?

  kos      Kos  @relation(fields: [kosId], references: [id])
  user     User @relation(fields: [userId], references: [id])
}

enum Role {
  OWNER
  SOCIETY
}

enum Gender {
  MALE
  FEMALE
  ALL
}

enum BookingStatus {
  PENDING
  ACCEPT
  REJECT
}